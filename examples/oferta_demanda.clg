programa AnalisisMercado {
    numero oferta = 120;
    numero demanda = 95;
    numero precio = 50;
    numero excedente = oferta - demanda;
    booleano hay_excedente = oferta > demanda;
    texto titulo = "Analisis de oferta y demanda";

    imprimir titulo;
    imprimir excedente;

    si (hay_excedente y precio >= 50) {
        imprimir "Oferta mayor que demanda";
    } sino {
        imprimir "Demanda mayor o igual a oferta";
    }

    mientras (demanda < oferta) {
        demanda = demanda + 5;
        imprimir demanda;
    }
}
